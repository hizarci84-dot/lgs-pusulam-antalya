# LGS Pusulam – Antalya Sunucu Ortam Değişkenleri
# API anahtarları sunucu tarafında güvenle okunur (.env dosyası .gitignore içindedir).

# Port yapılandırması (isteğe bağlı, varsayılan: 3001)
PORT=3001

# Google Gemini Vision & Karalama Temizleme Modeli (Önerilen Model: gemini-3.5-flash-lite)
# Google AI Studio'dan (https://aistudio.google.com/) alacağınız API anahtarı:
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3.5-flash-lite

# Alternatif OpenAI Vision Modeli (İsteğe bağlı):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
